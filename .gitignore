# IntelliJ : on garde la configuration partageable, pas l'état personnel
.idea/workspace.xml
.idea/shelf/
.idea/tasks.xml
.idea/usage.statistics.xml
out/

# Claude Code : réglages locaux personnels
.claude/settings.local.json

# Flutter / Dart (complété par flutter create)
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml.bak
.pub-cache/
.pub/
/coverage/
**/doc/api/
migrate_working_dir/
# Symboles et cartes de débogage produits par --split-debug-info / --obfuscate
app.*.symbols
app.*.map.json
# Sorties de compilation Android
/android/app/debug
/android/app/profile
/android/app/release

# Fichiers divers ignorés par le modèle Flutter (.idea/ et *.iml restent suivis exprès)
*.class
*.log
*.pyc
*.swp
*.iws
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/

# Système
Thumbs.db
desktop.ini
.DS_Store
# IntelliJ : le client ignore .idea sur main (son commit du 16/11) ;
# il reste suivi sur dev à sa demande.
/.idea/
