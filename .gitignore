# IntelliJ : tout le dossier .idea est suivi dans Git (demande du client)
out/

# Claude Code : réglages locaux personnels
.claude/settings.local.json

# Flutter / Dart (complété par flutter create)
.dart_tool/
# build/ est ignoré, SAUF l'application Windows prête à lancer
# (build/windows/x64/runner/Release/), suivie dans Git à la demande du client.
# Les fichiers intermédiaires (CMake, .obj, Debug) restent ignorés.
build/*
!build/windows/
build/windows/*
!build/windows/x64/
build/windows/x64/*
!build/windows/x64/runner/
build/windows/x64/runner/*
!build/windows/x64/runner/Release/
.flutter-plugins
.flutter-plugins-dependencies
*.iml.bak
.pub-cache/
.pub/
/coverage/
**/doc/api/
migrate_working_dir/
# Symboles et cartes de débogage produits par --split-debug-info / --obfuscate
app.*.symbols
app.*.map.json
# Sorties de compilation Android
/android/app/debug
/android/app/profile
/android/app/release

# Fichiers divers ignorés par le modèle Flutter (.idea/ et *.iml restent suivis exprès)
*.class
*.log
*.pyc
*.swp
*.iws
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/

# Système
Thumbs.db
desktop.ini
.DS_Store

# IntelliJ : bibliothèques générées avec des chemins propres à la machine

# Fichiers à installer (exe, apk) préparés pour une version : jamais dans Git
livraisons/
